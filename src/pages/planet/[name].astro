--- 
// @ts-nocheck
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/detail.css";
import PlanetInfoCard from "../../components/PlanetInfoCard.astro";
import TiltMeter from "../../components/TiltMeter.astro";
import TemperatureMeter from "../../components/TemperatureMeter.astro";

// 🔥 1. Alle planeten ophalen en routes genereren
export async function getStaticPaths() {
  const response = await fetch("https://api.le-systeme-solaire.net/rest/bodies/", {
    headers: {
      Authorization: `Bearer ${import.meta.env.SOLAR_API_KEY}`,
    },
  });

  const data = await response.json();

  return data.bodies
    .filter((body) => body.isPlanet)
    .map((planet) => ({
      params: {
        name: planet.englishName.toLowerCase(),
      },
      props: {
        planet, // 👈 stuur hele object door
      },
    }));
}

// 🔥 2. Geen fetch meer nodig!
const { planet } = Astro.props;

// Texture mapping
const textureMap = {
  Sun: "/images/planets/sun.png",
  Mercury: "/images/planets/mercury.png",
  Venus: "/images/planets/venus.png",
  Earth: "/images/planets/earth.png",
  Mars: "/images/planets/mars.png",
  Jupiter: "/images/planets/jupiter.png",
  Saturn: "/images/planets/saturn.png",
  Uranus: "/images/planets/uranus.png",
  Neptune: "/images/planets/neptune.png",
};

const texture = textureMap[planet.englishName];
const moonCount = planet.moons ? planet.moons.length : 0;

const tempK = planet.avgTemp;
const tempC = Math.round(tempK - 273.15);

const earthTempC = 15;
const tempDifference = tempC - earthTempC;

let tempComparison = "";

if (tempDifference === 0) {
  tempComparison = "About the same as Earth";
} else if (tempDifference > 0) {
  tempComparison = tempDifference + "°C warmer than Earth";
} else {
  tempComparison = Math.abs(tempDifference) + "°C colder than Earth";
}

const earthGravity = 9.81;

const gravity = planet.gravity;
const gravityRatio = gravity / earthGravity;

let gravityComparison;

if (gravityRatio === 1) {
  gravityComparison = "Same as Earth";
} else if (gravityRatio > 1) {
  gravityComparison = gravityRatio.toFixed(2) + "x stronger than Earth";
} else {
  gravityComparison = gravityRatio.toFixed(2) + "x weaker than Earth";
}

const yourWeight = 70; // kg 
const weightOnPlanet = Math.round(yourWeight * gravityRatio);

--- 

<BaseLayout title={planet.englishName}>
  <main class="planet-detail">
    <a class="back-link" href="/">← Back to solar system</a>

    <section class="planet-hero">
      <section>
        <div class="planet-content">
          <p class="eyebrow">Planet</p>
          <h1>{planet.englishName}</h1>

          <p class="intro">
            Explore {planet.englishName}, including its size, gravity,
            distance from the Sun and axial tilt.
          </p>
        </div>

        <div class="planet-visual">
          {texture && (
            <img src={texture} alt={planet.englishName} />
          )}
        </div>
      </section>

      <section class="planet-extra">
        <TiltMeter value={planet.axialTilt} />
        <TemperatureMeter temp={tempC} comparison={tempComparison} />
      </section>

      <section class="planet-stats">
        <PlanetInfoCard label="Mean radius" value={`${planet.meanRadius} km`} />
        <article class="card gravity-card" id="gravity-card">
          <p class="label">Gravity</p>
          <p class="value">{planet.gravity} m/s²</p>

          <div class="gravity-extra">
            <p>{gravityComparison}</p>
            <p>Your weight: {weightOnPlanet} kg</p>
          </div>
        </article>
        <article class="card distance-card" id="distance-card">
          <p class="label">Distance from Sun</p>
          <p class="value">{planet.semimajorAxis.toLocaleString()} km</p>

          <div class="distance-facts" id="distance-facts">
            <p>🗼 Eiffel Towers: {Math.round((planet.semimajorAxis * 1000) / 330).toLocaleString()}</p>
            <p>🏙️ Burj Khalifas: {Math.round((planet.semimajorAxis * 1000) / 828).toLocaleString()}</p>
            <p>🗽 Statues of Liberty: {Math.round((planet.semimajorAxis * 1000) / 93).toLocaleString()}</p>
          </div>
        </article>
        <PlanetInfoCard label="Moons" value={moonCount} />
        
        
      
      </section>
    </section>
  </main>
</BaseLayout>
<script>
  const distanceCard = document.getElementById("distance-card");

  distanceCard?.addEventListener("click", () => {
    distanceCard.classList.toggle("active");
  });


  const gravityCard = document.getElementById("gravity-card");

  gravityCard?.addEventListener("click", () => {
    gravityCard.classList.toggle("active");
  });

</script>